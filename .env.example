# Creator OS — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# ── Aether Coach (Phase 8) ────────────────────────────────────────────────────
# LLM provider for the Coach narrative.
# phi   (default) = phi3.5:3.8b — fast, structured JSON output
# gemma           = gemma2:9b   — richer narrative quality
# Switch with: COACH_PROVIDER=gemma cargo tauri dev
COACH_PROVIDER=phi

# ── M0 Daemon ─────────────────────────────────────────────────────────────────
# M0 runs at localhost:7400 (Caddy proxy) in dev.
# M0_URL=http://localhost:7400

# ── Ollama ────────────────────────────────────────────────────────────────────
# Ollama must be running: ollama serve
# Default: http://localhost:11434 (hardcoded in adapter-runtime)
