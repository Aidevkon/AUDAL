{
    "antigravity.indexing.include": [
        "apps/stillair/cockpit-dioxus/src/**/*",
        "aether/src/**/*",
        "cockpit/src/**/*"
    ],
    "python.defaultInterpreterPath": "./.venv/bin/python",
    "rust-analyzer.files.excludeDirs": [
        "target",
        "dist",
        "apps/stillair/cockpit-dioxus/target",
        "apps/stillair/cockpit-dioxus/dist"
    ],
    "rust-analyzer.cargo.buildScripts.enable": false,
    "rust-analyzer.procMacro.enable": true,
    "antigravity.agent.context.maxFiles": 120,
    "antigravity.agent.context.maxTokens": 32000,
    "antigravity.agent.context.followImports": true,
    "antigravity.agent.context.includeTests": false,
    "antigravity.agent.context.preferLocalSymbols": true
}