{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "Still Air",
  "version": "0.1.0",
  "identifier": "ai.stillair.cockpit",
  "build": {
    "frontendDist": "../cockpit-dioxus/dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "cd /home/aidevcon/Documents/creator-os/apps/stillair/cockpit-dioxus && trunk serve --port 1421",
    "beforeBuildCommand": "cd /home/aidevcon/Documents/creator-os/apps/stillair/cockpit-dioxus && trunk build --release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [

      {
        "title": "Still Air — Creator OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
