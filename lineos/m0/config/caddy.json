{
  "admin": {
    "disabled": true
  },
  "apps": {
    "http": {
      "servers": {
        "m0_proxy": {
          "listen": [
            "127.0.0.1:7400"
          ],
          "routes": [
            {
              "match": [
                {
                  "path": [
                    "/health"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:7401"
                    }
                  ],
                  "transport": {
                    "protocol": "http"
                  }
                }
              ]
            },
            {
              "match": [
                {
                  "path": [
                    "/master"
                  ]
                }
              ],
